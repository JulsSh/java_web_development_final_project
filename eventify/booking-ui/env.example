# ========================================
# Event Booking Frontend Configuration
# ========================================

# Your backend URL
REACT_APP_API_URL=http://localhost:8080

# Application mode
# true  - use built-in mocks (demo data)
# false - use real API
REACT_APP_USE_MOCKS=true

# ========================================
# Configuration examples for different scenarios
# ========================================

# Option 3: Local run with mocks
# REACT_APP_USE_MOCKS=true
# REACT_APP_API_URL=http://localhost:8080

# Option 4: Local run with real backend
# REACT_APP_API_URL=http://localhost:8080
# REACT_APP_USE_MOCKS=false

# Docker with real backend (Option 2)
# REACT_APP_API_URL=http://host.docker.internal:8080
# REACT_APP_USE_MOCKS=false

# Production
# REACT_APP_API_URL=https://your-backend-domain.com
# REACT_APP_USE_MOCKS=false

# ========================================
# Notes:
# ========================================
# - For Docker with mocks (Option 1) no variables are needed
# - For local run with mocks (Option 3) use npm run start:mocks
# - For local run with backend (Option 4) use npm run start:backend
# - Port 8080 must be free for your real backend
